{
  "buildCommand": "cd frontend && yarn install && CI=false yarn build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/demos/[id]/index.py": {
      "includeFiles": "api/assets_logo.b64"
    },
    "api/leads.py": {
      "includeFiles": "api/assets_logo.b64"
    }
  },
  "rewrites": [
    { "source": "/api/leads/:lead_id", "destination": "/api/leads?lead_id=:lead_id" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/demos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/api/leads(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    }
  ]
}
